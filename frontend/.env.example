# Optional. Leave unset to run the built-in in-browser baselines.
# Set this to the team's prediction service to use the trained models instead.
# It can also be changed at runtime from the app header.
VITE_API_BASE_URL=http://localhost:8000

# Optional. The path the site is served from. The Pages workflow sets this to
# "/<repo-name>/" automatically; set it to "/" for a custom domain.
# VITE_BASE=/
